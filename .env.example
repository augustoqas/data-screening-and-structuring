# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# TRIAGE_MODEL=gpt-5.4-mini
# TRIAGE_PROMPT_VERSION=v1
# TRIAGE_REQUEST_TIMEOUT_S=30
# TRIAGE_TEMPERATURE=          # leave unset for reasoning models, which reject it
# TRIAGE_REASONING_EFFORT=low  # minimal | low | medium | high (reasoning models only)
